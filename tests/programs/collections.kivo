let users = [
    "Hugo",
    "Alex",
    "Sam"
]
print(users, len(users), users.length)
print(users[0], users.first(), users.last())
users.push("Kim")
print(users.contains("Kim"), users.indexOf("Sam"))
print(users.join(", "))
print(users.slice(1, 3))
print(users.sort())
print(users.reverse())

let numbers = [5, 3, 8, 1]
print(numbers.sum(), numbers.min(), numbers.max(), numbers.average())
print(numbers.filter(n => n > 3))
print(numbers.reduce((total, n) => total + n, 0))
print(numbers.sort((a, b) => b - a))
print(numbers.find(n => n > 4), numbers.any(n => n > 7), numbers.all(n => n > 0))
print([1, 1, 2, 3, 3].unique(), [[1, 2], [3]].flat())
print([...numbers, 9], numbers.concat([0]))

let user = {
    name: "Hugo",
    coins: 500,
    admin: true
}
print(user.name, user.coins, user.admin)
user.coins += 1
user.email = "hugo@example.com"
print(user)
print(keys(user), len(user))
print(has(user, "email"), has(user, "phone"))
print(user["name"], user["missing"] ?? "default")

let key = "coins"
print(user[key])

for k, v in { a: 1, b: 2 } {
    print(k, "=", v)
}

let nested = { player: { stats: { level: 7 } } }
print(nested.player.stats.level)

let merged = { ...user, coins: 0 }
print(merged.coins, user.coins)

let shorthand = { users, numbers }
print(len(shorthand.users))

let people = [
    { name: "Zed", age: 30 },
    { name: "Amy", age: 25 },
    { name: "Bob", age: 35 }
]
print(people.sort(p => p.age).map(p => p.name))
print(people.groupBy(p => if_old(p)))

func if_old(p) {
    if p.age >= 30 {
        return "old"
    }
    return "young"
}

print([1, 2] == [1, 2], { a: 1 } == { a: 1 }, [1, 2] == [2, 1])
