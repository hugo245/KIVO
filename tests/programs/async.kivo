import time

async func loadNumber(n) {
    await time.sleep(5)
    return n * 2
}

async func main() {
    let a = await loadNumber(1)
    let b = await loadNumber(2)
    print("results:", a, b)
    let all = []
    for i in 1..3 {
        all.push(await loadNumber(i))
    }
    print(all)
}

await main()
print("top-level await works:", await loadNumber(21))
