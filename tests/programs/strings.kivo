let name = "Hugo"
let user = { name: "Alex", coins: 42 }

print("Hello {name}")
print("Hello {user.name}, you have {user.coins} coins")
print("Math works too: {1 + 2 * 3}")
print("Nested: {"inner {name}"}")
print("Escapes: tab\tnewline\\n quote\" brace \{literal}")
print("Unicode: é \u{1F600}")

let text = "  Hello, World  "
print(text.trim(), text.trim().upper(), text.trim().lower())
print("a,b,c".split(","), "one two  three".split())
print("hello".contains("ell"), "hello".startsWith("he"), "hello".endsWith("lo"))
print("hello".replace("l", "L"), "hello".indexOf("l"), "hello".count("l"))
print("abc".repeat(3), "7".padStart(3, "0"), "hello".slice(1, 3), "hello".slice(-3))
print("hello".chars(), "hello".reverse(), len("hello"), "hello"[1])
print("42".toNumber(), "nope".toNumber(), number("3.5") + 1, int("42") * 2)
print(string(12) + "!", string([1, 2]), string(null))

let multi = """
    Dear {name},
      indented line
    Bye
    """
print(multi)
